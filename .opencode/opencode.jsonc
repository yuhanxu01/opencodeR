{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "STYLE_GUIDE.md"
  ],
  "provider": {
    "opencode": {
      "options": {}
    },
    "deepseek": {
      "options": {}
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  },
  "agent": {
    "general": {
      "name": "General Reasoning",
      "description": "Sub-agent for deep reasoning tasks using DeepSeek",
      "mode": "subagent",
      "model": "deepseek/deepseek-reasoner"
    },
    "stem-research": {
      "name": "STEM Research",
      "description": "Research assistant for math, physics, CS, and engineering",
      "mode": "primary",
      "temperature": 0.1,
      // Uses default model (GLM) for main tasks
      "prompt": "You are a STEM research assistant. Always cite your sources from .opencode/literature/ with file paths and line numbers."
    },
    "literature-organizer": {
      "name": "Literature Organizer",
      "description": "Automatically organize literature files from files/ into appropriate categories",
      "mode": "primary",
      "temperature": 0.1,
      // Uses default model (GLM) for task execution
      "prompt": "You are a literature organizer. List files in files/, read each file, categorize by keywords, move to .opencode/literature/[category]/, and generate a report. Show all bash commands and outputs."
    }
  }
}